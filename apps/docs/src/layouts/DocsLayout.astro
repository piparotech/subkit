---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { Breadcrumbs } from '@/components/ui/breadcrumbs'
import { PageActions } from '@/components/ui/page-actions'
import { Pagination } from '@/components/ui/pagination'
import { Sidebar } from '@/components/ui/sidebar'
import { TOC } from '@/components/ui/toc'
import type { DocsPageProps } from 'nimbus-docs/types'

interface Props extends DocsPageProps {}

const props = Astro.props
const sidebarItems = props.sidebar === false ? null : props.sidebar
const tocItems = props.headings === false ? null : props.headings
const showSidebar = sidebarItems !== null
const showToc = tocItems !== null && tocItems.length > 0
---

<BaseLayout
  title={props.title}
  description={props.description}
  noindex={props.noindex}
  markdownUrl={props.markdownUrl}
  socialImage={props.socialImage}
  lastUpdated={props.lastUpdated}
  head={props.head}
  collection={props.collection}
  entryId={props.entryId}
>
  {props.banner && (
    <div class={`site-banner site-banner-${props.banner.type ?? 'note'}`}>{props.banner.content}</div>
  )}

  <div class:list={['docs-shell', !showSidebar && 'without-sidebar', !showToc && 'without-toc']}>
    {sidebarItems && (
      <>
        <aside class="sidebar-rail" aria-label="Documentation navigation">
          <Sidebar items={sidebarItems} persist />
        </aside>
        <details class="mobile-navigation">
          <summary>Browse documentation</summary>
          <nav aria-label="Mobile documentation navigation">
            <Sidebar items={sidebarItems} />
          </nav>
        </details>
      </>
    )}

    <main id="main-content" class="docs-main" tabindex="-1" data-pagefind-body>
      <Breadcrumbs items={props.breadcrumbs} />
      <header class="page-header">
        <h1>{props.title}</h1>
        {props.description && <p>{props.description}</p>}
        <PageActions markdownUrl={props.markdownUrl} lastUpdated={props.lastUpdated} />
        {props.editUrl && (
          <a class="edit-link" href={props.editUrl} target="_blank" rel="noopener">
            Edit this page
          </a>
        )}
      </header>
      <article class="docs-prose">
        <slot />
      </article>
      <Pagination prevNext={props.prevNext} />
    </main>

    {tocItems && tocItems.length > 0 && (
      <aside class="toc-rail">
        <TOC headings={tocItems} />
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: var(--nb-sidebar-width) minmax(0, var(--nb-content-max)) var(--nb-toc-width);
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    padding: 0 clamp(1rem, 3vw, 2rem);
  }

  .docs-shell.without-sidebar {
    grid-template-columns: minmax(0, var(--nb-content-max)) var(--nb-toc-width);
  }

  .docs-shell.without-toc {
    grid-template-columns: var(--nb-sidebar-width) minmax(0, var(--nb-content-max));
  }

  .docs-shell.without-sidebar.without-toc {
    grid-template-columns: minmax(0, var(--nb-content-max));
  }

  .sidebar-rail,
  .toc-rail {
    position: sticky;
    top: var(--nb-header-height);
    max-height: calc(100vh - var(--nb-header-height));
    overflow-y: auto;
    padding-block: 1.5rem 3rem;
  }

  .sidebar-rail {
    border-right: 1px solid var(--nb-border);
    padding-right: 1rem;
  }

  .toc-rail {
    padding-left: 0.5rem;
  }

  .mobile-navigation {
    display: none;
  }

  .docs-main {
    min-width: 0;
    padding-block: 1.5rem 4rem;
  }

  .page-header {
    margin: 1.4rem 0 2rem;
  }

  .page-header h1 {
    margin: 0;
    font-size: clamp(2.2rem, 6vw, 4rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .page-header > p {
    max-width: 64ch;
    margin: 0.9rem 0 1.2rem;
    color: var(--nb-muted-foreground);
    font-size: 1.08rem;
    text-wrap: pretty;
  }

  .edit-link {
    display: inline-flex;
    margin-top: 0.35rem;
    color: var(--nb-muted-foreground);
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .edit-link:hover {
    color: var(--nb-primary);
    text-decoration: underline;
  }

  .site-banner {
    border-bottom: 1px solid var(--nb-border);
    background: var(--nb-info-muted);
    padding: 0.65rem 1rem;
    text-align: center;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .site-banner-caution,
  .site-banner-danger {
    background: var(--nb-warning-muted);
  }

  @media (max-width: 72rem) {
    .docs-shell,
    .docs-shell.without-sidebar,
    .docs-shell.without-toc {
      grid-template-columns: minmax(14rem, var(--nb-sidebar-width)) minmax(0, var(--nb-content-max));
    }

    .toc-rail {
      display: none;
    }
  }

  @media (max-width: 52rem) {
    .docs-shell,
    .docs-shell.without-sidebar,
    .docs-shell.without-toc {
      display: block;
      padding-inline: clamp(1rem, 5vw, 1.5rem);
    }

    .sidebar-rail {
      display: none;
    }

    .mobile-navigation {
      display: block;
      border-bottom: 1px solid var(--nb-border);
      padding-block: 0.75rem;
    }

    .mobile-navigation summary {
      cursor: pointer;
      color: var(--nb-foreground);
      font-weight: 700;
    }

    .mobile-navigation nav {
      max-height: min(65vh, 34rem);
      overflow-y: auto;
      padding-top: 0.75rem;
    }
  }
</style>
