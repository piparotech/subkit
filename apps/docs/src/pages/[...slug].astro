---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import {
  getBreadcrumbs,
  getDocsPageProps,
  getEditUrl,
  getLastUpdated,
  getPrevNext,
  getSidebar,
  getTOC,
} from 'nimbus-docs'
import { components } from '@/components'
import DocsLayout from '@/layouts/DocsLayout.astro'
import LandingLayout from '@/layouts/LandingLayout.astro'

export const prerender = true
export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection('docs', ({ data }) => !data.draft)
  return entries.map((entry) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry },
  }))
}

const { entry, Content, headings } = await getDocsPageProps(Astro)
const route = entry.id === 'index' ? '/' : `/${entry.id}/`
const markdownUrl = entry.id === 'index' ? '/index.md' : `${route}index.md`
const sidebar = entry.data.sidebar === false ? false : await getSidebar(route)
const tableOfContents = entry.data.tableOfContents
const toc =
  tableOfContents === false
    ? false
    : getTOC(headings, typeof tableOfContents === 'object' ? tableOfContents : undefined)
const breadcrumbs = await getBreadcrumbs(route, { collection: entry.collection })
const prevNext = await getPrevNext(route, {
  overrides: { prev: entry.data.prev, next: entry.data.next },
  sidebarTree: sidebar === false ? undefined : sidebar,
})
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry))
const editUrl = await getEditUrl(entry)
const Layout = entry.data.mode === 'custom' ? LandingLayout : DocsLayout
---

<Layout
  title={entry.data.title}
  description={entry.data.description}
  mode={entry.data.mode}
  searchable={entry.data.searchable}
  draft={entry.data.draft}
  noindex={entry.data.noindex}
  editUrl={editUrl}
  banner={entry.data.banner}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  markdownUrl={markdownUrl}
  lastUpdated={lastUpdated}
  socialImage={entry.data.socialImage}
  head={entry.data.head}
  collection={entry.collection}
  entryId={entry.id}
>
  <Content components={components} />
</Layout>
