{
  "name": "@piparotech/subkit-expo",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "sideEffects": false,
  "description": "Private SubKit Expo IAP SDK skeleton with automatic purchase sync.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./expo-iap": {
      "types": "./dist/expoIapAdapter.d.ts",
      "development": "./src/expoIapAdapter.ts",
      "import": "./dist/expoIapAdapter.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter @piparotech/subkit-core build && pnpm run build && node --import ./test/register-loader.mjs --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1"
  },
  "peerDependencies": {
    "@piparotech/subkit-core": "workspace:^",
    "expo": "*",
    "expo-iap": "*",
    "react": ">=18",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@piparotech/subkit-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@piparotech/subkit-core": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  }
}
