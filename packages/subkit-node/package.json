{
  "name": "@piparotech/subkit-node",
  "version": "0.1.9",
  "type": "module",
  "description": "Node.js backend SDK for querying SubKit.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piparotech/subkit.git",
    "directory": "packages/subkit-node"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@piparotech/subkit-core": "workspace:^"
  },
  "devDependencies": {
    "@piparotech/subkit-core": "workspace:*",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
