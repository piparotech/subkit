{
  "name": "@piparotech/subkit-node",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Node.js backend SDK for querying SubKit.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@piparotech/subkit-core": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
